ENVIRONMENT=development
LOG_LEVEL=INFO

# LLM Configuration (OpenAI)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_MODEL_WORKER=gpt-4o-mini
OPENAI_MODEL_GUARDRAIL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30.0
OPENAI_MAX_TOKENS_WORKER=2048
OPENAI_MAX_TOKENS_GUARDRAIL=512

# Database & Cache (Docker Compose)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/planmytrip
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=20
REDIS_URL=redis://localhost:6380/0

# Authentication & Security
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=43200

# Live Travel & Search APIs
FLIGHTAPI_KEY=your_flightapi_io_key
SERPAPI_API_KEY=your_serpapi_key
TAVILY_API_KEY=your_tavily_api_key
OPENWEATHER_API_KEY=your_openweather_key
AVIATIONSTACK_API_KEY=your_aviationstack_key

# Microservices MCP Ports
MCP_FLIGHT_URL=http://localhost:8001
MCP_WEATHER_URL=http://localhost:8002
MCP_PLACES_URL=http://localhost:8003
